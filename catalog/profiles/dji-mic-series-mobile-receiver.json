{
  "schema_version": 1,
  "id": "dji-mic-series-mobile-receiver",
  "profile_version": 1,
  "origin": "official",
  "status": "verified",
  "updated": "2026-09-12",
  "device": {
    "vendor": "DJI",
    "model": "Mic Series Mobile Receiver",
    "aliases": [
      "DJI Mic Series Mobile Receiver"
    ],
    "category": "Microphone"
  },
  "firmware": {
    "strategy": "release_notes_pdf",
    "source": {
      "type": "html",
      "url": "https://www.dji.com/global/downloads/products/mic-mini"
    },
    "discovery": {
      "document_type": "pdf",
      "item_selector": "div[class^=\"style__document-item___\"], li.groups-download-item",
      "title_contains": [
        "DJI Mic Mini  - Release Notes (Mobile RX)"
      ],
      "url_contains": [
        "DJI_Mic_Series_MobileRX_Release_Notes"
      ],
      "url_excludes": [],
      "url_pattern": "(?:_|-)en(?:[_.0-9-]|\\.pdf)"
    },
    "extraction": {
      "version": {
        "labels": [
          "Firmware"
        ],
        "pattern": "(?:[Vv]\\s*)?([0-9]+(?:\\.[0-9]+){2,3})",
        "group": 1,
        "max_lines": 12,
        "header_pattern": "^Firmware ([Vv][0-9.]+)$"
      },
      "release_date": {
        "labels": [
          "Date:"
        ],
        "formats": [
          "%Y.%m.%d"
        ],
        "max_lines": 12,
        "header_pattern": "^Date (\\d{4}\\.\\d{1,2}\\.\\d{1,2})$"
      },
      "whats_new": {
        "start_labels": [
          "What's New",
          "What's New?"
        ],
        "end_labels": [
          "Notes",
          "Notes:",
          "https://www.dji.com/mic-mini"
        ],
        "max_items": 10
      },
      "scope": "first_release_first_page",
      "pdf_text": {
        "x_tolerance": 1
      }
    },
    "validation": {
      "version_pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$",
      "document_titles": [
        "DJI Mic Series Mobile Receiver Release Notes"
      ]
    }
  }
}
