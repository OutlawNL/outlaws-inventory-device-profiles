        "DJI O3 Air Unit  - Release Notes v1.4"
      ],
      "url_contains": [
        "DJI_O3_Air_Unit_Release_Notes_U3"
      ],
      "url_excludes": [],
      "url_pattern": "(?:_|-)en(?:[_.0-9-]|\\.pdf)"
    },
    "extraction": {
      "version": {
        "labels": [
          "DJI O3 Air Unit Firmware:"
        ],
        "pattern": "(?:[Vv]\\s*)?([0-9]+(?:\\.[0-9]+){2,3})",
        "group": 1,
        "max_lines": 12
      },
      "release_date": {
        "labels": [
          "Date:"
        ],
        "formats": [
          "%Y.%m.%d"
        ],
        "max_lines": 12
      },
      "whats_new": {
        "start_labels": [
          "What's New?"
        ],
        "end_labels": [
          "Notes:"
        ],
        "max_items": 10
      },
      "scope": "first_release_first_page",
      "pdf_text": {
        "x_tolerance": 1
      }
    },
    "validation": {
      "version_pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$",
      "document_titles": [
        "DJI O3 Air Unit Release Notes"
      ]
    }
  }
