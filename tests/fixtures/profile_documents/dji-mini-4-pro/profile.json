      "type": "html",
      "url": "https://www.dji.com/nl/mini-4-pro/downloads"
    },
    "discovery": {
      "document_type": "pdf",
      "item_selector": "li.groups-download-item",
      "title_contains": [
        "DJI Mini 4 Pro  - Release Notes"
      ],
      "url_contains": [
        "DJI_Mini_4_Pro_Release_Notes"
      ],
      "url_excludes": [],
