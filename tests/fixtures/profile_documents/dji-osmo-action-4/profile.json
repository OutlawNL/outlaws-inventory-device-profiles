        "max_lines": 12
      },
      "release_date": {
        "labels": [
          "Date:"
        ],
        "formats": [
          "%Y.%m.%d"
        ],
        "max_lines": 12
      },
      "whats_new": {
        "start_labels": [
          "What's New",
          "What\u2019s New",
          "What's New?",
          "What\u2019s New?"
        ],
        "end_labels": [
          "Notes:",
          "Notes"
        ],
        "max_items": 10
      },
      "scope": "first_release_first_page"
    },
    "validation": {
      "version_pattern": "^[0-9]+(?:\\.[0-9]+){2,3}$",
      "document_titles": [
        "DJI Osmo Action 4 Release Notes"
      ]
