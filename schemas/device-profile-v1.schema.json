{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OutlawNL/outlaws-inventory-device-profiles/schemas/device-profile-v1.schema.json",
  "title": "Outlaw's Inventory Device Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_version",
    "origin",
    "status",
    "updated",
    "device",
    "firmware"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "enum": [
        "official",
        "community",
        "custom"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "experimental",
        "deprecated"
      ]
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "model",
        "category"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "source",
        "extraction"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "release_notes_pdf",
            "dji_release_notes_pdf",
            "html_release"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "enum": [
                "html"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "document_type",
            "title_contains"
          ],
          "properties": {
            "document_type": {
              "const": "pdf"
            },
            "title_contains": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            },
            "url_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "url_excludes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "item_selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "url_pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "release_date",
            "whats_new"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/labeledValue"
            },
            "release_date": {
              "$ref": "#/$defs/labeledDate"
            },
            "whats_new": {
              "$ref": "#/$defs/section"
            },
            "scope": {
              "enum": [
                "first_release_first_page",
                "first_release_for_target"
              ]
            },
            "pdf_text": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x_tolerance": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 5
                }
              }
            },
            "skip_when_labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "html": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title_selector",
                "header_selector",
                "release_selector",
                "release_version_selector",
                "release_version_pattern",
                "summary_selector"
              ],
              "properties": {
                "title_selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "header_selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "release_selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "release_version_selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "release_version_pattern": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "summary_selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "document_titles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            }
          }
        },
        "release_notes": {
          "type": "object",
          "description": "Legacy v0.18.0/v0.18.1 DJI profile fields retained for schema compatibility.",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "firmware_labels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "enum": [
                  "release_notes_pdf",
                  "dji_release_notes_pdf"
                ]
              }
            }
          },
          "then": {
            "required": [
              "discovery"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "html_release"
              }
            }
          },
          "then": {
            "properties": {
              "extraction": {
                "required": [
                  "html"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "labeledValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "pattern"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 12
        },
        "header_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "labeledDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labels",
        "formats"
      ],
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 12
        },
        "header_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_labels",
        "end_labels"
      ],
      "properties": {
        "start_labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "end_labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        }
      }
    }
  }
}
