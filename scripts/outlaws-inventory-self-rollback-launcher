#!/usr/bin/env bash
set -euo pipefail
UNIT="outlaws-inventory-self-rollback-$(date +%s)"
exec /usr/bin/systemd-run \
  --quiet \
  --no-block \
  --collect \
  --unit="$UNIT" \
  --description="Outlaw's Inventory independent rollback" \
  --property=Type=oneshot \
  --property=TimeoutStartSec=20min \
  --property=Nice=5 \
  --on-active=1s \
  /usr/local/sbin/outlaws-inventory-self-rollback
