#!/usr/bin/env python3
"""Root-side verification against the fixed official GitHub repository.

Never execute this module or an updater from service-writable staging before
verification. Installed by the administrator as a root-owned helper.
"""
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request
import zipfile

REPOSITORY = "OutlawNL/outlaws-inventory"
STAGING = Path("/opt/outlaws-inventory/data/update-staging")
TOKEN_FILE = Path("/opt/outlaws-inventory/data/secrets/github-token")
ALLOWED_HOSTS = {"api.github.com", "github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com"}
MAX_PACKAGE = 512 * 1024 * 1024


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def fetch(url, token, accept="application/vnd.github+json"):
    opener = urllib.request.build_opener(NoRedirect())
    for _ in range(5):
        parts = urllib.parse.urlsplit(url)
        if parts.scheme != "https" or parts.hostname not in ALLOWED_HOSTS or parts.username:
            raise ValueError("Untrusted release metadata URL")
        headers = {"User-Agent": "OutlawsInventory-RootVerifier", "Accept": accept}
        if token and parts.hostname == "api.github.com":
            headers["Authorization"] = "Bearer " + token
        try:
            with opener.open(urllib.request.Request(url, headers=headers), timeout=30) as response:
                data = response.read(2 * 1024 * 1024 + 1)
                if len(data) > 2 * 1024 * 1024:
                    raise ValueError("Release metadata exceeds limit")
                return data
        except urllib.error.HTTPError as exc:
            if exc.code not in (301, 302, 303, 307, 308):
                raise
            url = urllib.parse.urljoin(url, exc.headers["Location"])
    raise ValueError("Too many release metadata redirects")


def verify(pending, destination, *, staging=STAGING, token_file=TOKEN_FILE, fetcher=fetch):
    with pending.open("rb") as source:
        raw = source.read(65537)
    if len(raw) > 65536:
        raise ValueError("Invalid pending release")
    data = json.loads(raw)
    version = str(data.get("version", ""))
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[.-][A-Za-z0-9]+)?", version):
        raise ValueError("Invalid release version")
    name = f"outlaws-inventory-v{version}.zip"
    package = Path(str(data.get("zip", "")))
    if package != staging / name or package.is_symlink():
        raise ValueError("Invalid package path")
    token = token_file.read_text().strip() if token_file.is_file() else ""
    release = json.loads(fetcher(f"https://api.github.com/repos/{REPOSITORY}/releases/tags/v{version}", token))
    if release.get("draft") or release.get("tag_name") != f"v{version}":
        raise ValueError("Release is not published")
    assets = release.get("assets", [])
    checksum = [a for a in assets if a.get("name") == "SHA256SUMS"]
    packages = [a for a in assets if a.get("name") == name]
    if len(checksum) != 1 or len(packages) != 1:
        raise ValueError("Official release assets missing or ambiguous")
    # Construct the endpoint ourselves; do not trust URLs in pending metadata.
    asset_id = int(checksum[0]["id"])
    sums = fetcher(f"https://api.github.com/repos/{REPOSITORY}/releases/assets/{asset_id}", token, "application/octet-stream").decode()
    matches = [line.split()[0].lower() for line in sums.splitlines()
               if len(line.split()) == 2 and line.split()[1].lstrip("*") == name]
    if len(matches) != 1 or not re.fullmatch(r"[0-9a-f]{64}", matches[0]):
        raise ValueError("Official package checksum missing or ambiguous")
    target = destination / name
    digest = hashlib.sha256()
    fd = os.open(package, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as source, target.open("xb") as output:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_PACKAGE:
            raise ValueError("Invalid package size or type")
        total = 0
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            total += len(chunk)
            if total > MAX_PACKAGE:
                raise ValueError("Package exceeds limit")
            digest.update(chunk)
            output.write(chunk)
    if digest.hexdigest() != matches[0]:
        raise ValueError("Package does not match the official release checksum")
    root = f"outlaws-inventory-v{version}"
    with zipfile.ZipFile(target) as archive:
        entries = archive.infolist()
        names = [i.filename for i in entries]
        if len(names) != len(set(names)) or len(names) > 20000 or sum(i.file_size for i in entries) > 2 * 1024**3:
            raise ValueError("Invalid release archive limits")
        for entry in entries:
            path = Path(entry.filename)
            mode = entry.external_attr >> 16
            if path.is_absolute() or ".." in path.parts or "\\" in entry.filename or not path.parts or path.parts[0] != root or stat.S_ISLNK(mode):
                raise ValueError("Unsafe release archive member")
    return {"version": version, "zip": str(target), "sha256": digest.hexdigest()}


if __name__ == "__main__":
    print(json.dumps(verify(Path(sys.argv[1]), Path(sys.argv[2]))))
